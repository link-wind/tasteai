[
  {
    "id": "01-utf8",
    "lesson": "01-tokenization-basics.html",
    "title": "把文本编码成 UTF-8 字节",
    "task": "返回文本的 UTF-8 字节编号列表，保留空白，不做规范化。",
    "function": "encode_bytes",
    "cases": [
      {
        "name": "ASCII",
        "args": [
          "Hi"
        ],
        "expected": [
          72,
          105
        ]
      },
      {
        "name": "中文与emoji",
        "args": [
          "A中🙂"
        ],
        "expected": [
          65,
          228,
          184,
          173,
          240,
          159,
          153,
          130
        ]
      },
      {
        "name": "空输入",
        "args": [
          ""
        ],
        "expected": []
      },
      {
        "name": "组合重音",
        "args": [
          "é"
        ],
        "expected": [
          101,
          204,
          129
        ]
      },
      {
        "name": "保留空白",
        "args": [
          " a\n"
        ],
        "expected": [
          32,
          97,
          10
        ]
      }
    ],
    "scenarios": [
      {
        "label": "混合文本：A中🙂",
        "args": [
          "A中🙂"
        ]
      },
      {
        "label": "组合重音：e + ◌́",
        "args": [
          "é"
        ]
      }
    ],
    "hints": [
      "先调用字符串的 encode(\"utf-8\")。",
      "bytes 转成 list 后，每项都是 0～255 的整数。"
    ],
    "note": "字节编号不是任何真实模型的完整词表 ID。"
  },
  {
    "id": "03-pretokenization",
    "lesson": "03-gpt-tokenizers.html",
    "title": "动手写预分词边界",
    "task": "将连续 ASCII 字母、每段最多 3 个数字、连续空白分别成组；其余字符每个单独成组。",
    "function": "split_pieces",
    "cases": [
      {
        "name": "数字分三位",
        "args": [
          "abc12345!"
        ],
        "expected": [
          "abc",
          "123",
          "45",
          "!"
        ]
      },
      {
        "name": "保留空白",
        "args": [
          " a\n"
        ],
        "expected": [
          " ",
          "a",
          "\n"
        ]
      },
      {
        "name": "中文不吞并",
        "args": [
          "你好🙂"
        ],
        "expected": [
          "你",
          "好",
          "🙂"
        ]
      },
      {
        "name": "空文本",
        "args": [
          ""
        ],
        "expected": []
      },
      {
        "name": "标点与大小写",
        "args": [
          "Hi,AI!"
        ],
        "expected": [
          "Hi",
          ",",
          "AI",
          "!"
        ]
      }
    ],
    "scenarios": [
      {
        "label": "字母、数字和空白",
        "args": [
          "Hello 1234567!"
        ]
      },
      {
        "label": "中文与emoji",
        "args": [
          "你好 AI🙂\n"
        ]
      }
    ],
    "hints": [
      "使用 re.findall，让每个分支覆盖一种单位。",
      "数字分支使用 [0-9]{1,3}；最后一个分支接住其余单字符。"
    ],
    "note": "这是明确限定的教学规则，不复刻 GPT 的正则、BPE 词表或真实 token 数。"
  },
